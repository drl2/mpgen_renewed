{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build LESS to CSS",
      "type": "shell",
      "command": "lessc",
      "args": [
        "less/mpgen.less",
        "mpgen.css"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": true
      },
      "problemMatcher": {
        "owner": "less",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^([^:]+):(\\d+):(\\d+):\\s*(Error|Warning)\\s*:?\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "isBackground": false
    },
    {
      "label": "Watch LESS Files",
      "type": "shell",
      "command": "lessc",
      "args": [
        "--watch",
        "less/",
        "."
      ],
      "group": {
        "kind": "build"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": {
        "owner": "less",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^([^:]+):(\\d+):(\\d+):\\s*(Error|Warning)\\s*:?\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
