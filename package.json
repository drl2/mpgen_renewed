{
  "name": "mpgen-renewed",
  "version": "2.0.0",
  "description": "MPGEN - Multi-dimensional Character Generator. Consolidated vanilla JavaScript SPA.",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "build": "lessc less/mpgen.less mpgen.css",
    "build:prod": "node scripts/build-production.js",
    "watch": "lessc --watch less/ .",
    "serve": "python3 -m http.server 8000",
    "preview:prod": "python3 -m http.server 8000 --directory dist",
    "dev": "npm run watch & npm run serve"
  },
  "keywords": [
    "character-generator",
    "mpgen",
    "vanilla-javascript",
    "spa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-minifier-terser": "^7.2.0",
    "less": "^4.1.3"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "xlsx-populate": "^1.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
